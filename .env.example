# ==============================================================================
# COMMUNITY MANAGER - ENVIRONMENT CONFIGURATION
# ==============================================================================
# In production, values are automatically injected by the deployment platform.
# For local testing, copy this file to .env and fill in the values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_ENV=production
PORT=3000
APP_URL=https://discord.com/oauth2/authorize?client_id=1547515985416822884

# Session encryption secret (required in production)
SESSION_SECRET=https://community-manager-bot-720940628402.asia-southeast1.run.app/

# ------------------------------------------------------------------------------
# 2. DISCORD BOT & OAUTH INTEGRATION (REQUIRED FOR DISCORD FUNCTIONALITY)
# ------------------------------------------------------------------------------
# From Discord Developer Portal -> Your App -> General Information:
DISCORD_CLIENT_ID=1547515985416822884
DISCORD_APPLICATION_ID=1547515985416822884
# Must match DISCORD_CLIENT_ID for Vite client-side code:
VITE_DISCORD_CLIENT_ID=1547515985416822884

# From Discord Developer Portal -> Your App -> OAuth2:
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://discord.com/oauth2/authorize?client_id=1547515985416822884

# From Discord Developer Portal -> Your App -> Bot -> Token:
DISCORD_BOT_TOKEN=MTU0NzUxNTk4NTQxNjgyMjg4NA.GZX3sm.ZKk9wh_Xvf5v9aGQSOS99PkhbkxiDUeyZlisdA

# From Discord Developer Portal -> Your App -> General Information -> Public Key:
DISCORD_PUBLIC_KEY=522efd135b52e2b8e56ad6d7bebd2b787e5e78584301d4a69368ef5d98d3717f

# ------------------------------------------------------------------------------
# 3. GOOGLE CLOUD & FIRESTORE DATABASE (PERSISTENCE)
