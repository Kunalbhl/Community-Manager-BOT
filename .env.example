# ==============================================================================
# .env.example — TEMPLATE ONLY. Copy to .env and fill real values. Never commit .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME MODE (controls whether real Discord gateway is used)
# PRODUCTION             = real Discord bot, real Firestore, all features live
# REAL_DISCORD_PREVIEW   = real Discord bot, real Firestore, pre-production check
# DEVELOPMENT_SIMULATION = no real Discord connection, in-memory store (UI dev only)
# ------------------------------------------------------------------------------
APP_RUNTIME_MODE=PRODUCTION
NODE_ENV=production
APP_ENV=production
PORT=3000

# Your real deployed URL — Cloud Run URL or custom domain. No trailing slash.
APP_URL=https://your-cloudrun-service.asia-southeast1.run.app

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ------------------------------------------------------------------------------
# 2. DISCORD (ALL REQUIRED for bot to connect)
# Source: https://discord.com/developers/applications → your app
#   Bot tab          → Token (DISCORD_BOT_TOKEN)
#   General Info tab → Application ID, Public Key
#   OAuth2 tab       → Client ID, Client Secret
# ------------------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=

# MUST be: your APP_URL + /api/v1/auth/callback
# Register this exact string in Discord Developer Portal → OAuth2 → Redirects
DISCORD_REDIRECT_URI=https://your-cloudrun-service.asia-southeast1.run.app/api/v1/auth/callback

# Same value as DISCORD_CLIENT_ID — exposed to browser at build time (not a secret)
VITE_DISCORD_CLIENT_ID=

# ------------------------------------------------------------------------------
# 3. GOOGLE CLOUD / FIRESTORE (REQUIRED for data persistence)
# Your GCP Project ID from: https://console.cloud.google.com
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_REGION=asia-southeast1

# Use (default) unless you created a named Firestore database
# Named database format: just the name, e.g. my-database  (no parentheses, no URL)
FIRESTORE_DATABASE_ID=(default)

# ------------------------------------------------------------------------------
# 4. GEMINI AI (optional — for Community Brain AI features)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 5. PLATFORM OWNER (your Discord User ID — right-click yourself → Copy User ID)
# This is a numeric Discord snowflake ID, NOT your email address.
# ------------------------------------------------------------------------------
PLATFORM_OWNER_USER_ID=
PLATFORM_OWNER_EMAIL=
PLATFORM_ADMIN_KEY=

# ------------------------------------------------------------------------------
# 6. OPTIONAL INTEGRATIONS
# ------------------------------------------------------------------------------
GOOGLE_SHEETS_SPREADSHEET_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 7. DEV/LOCAL ONLY (ignored in production)
# ------------------------------------------------------------------------------
# Set to your actual Discord Guild ID when running in DEVELOPMENT_SIMULATION mode
DEV_GUILD_ID=
